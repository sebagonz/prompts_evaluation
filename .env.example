# Ejecutar `python3 litellm/setup.py init` para crear .env con secretos locales.
# Completar al menos la clave del proveedor elegido antes de auditar.
POSTGRES_PASSWORD=REEMPLAZAR_CON_VALOR_ALEATORIO
# Puerto del host; 4001 permite convivir con giskard-poc en 4000.
LITELLM_PORT=4001
LITELLM_MASTER_KEY=sk-REEMPLAZAR_CON_VALOR_ALEATORIO
LITELLM_SALT_KEY=sk-REEMPLAZAR_CON_VALOR_ALEATORIO
UI_USERNAME=local-admin
UI_PASSWORD=REEMPLAZAR_CON_VALOR_ALEATORIO

# Estas claves pertenecen a las API de los proveedores, no a LiteLLM.
# Preferir exportarlas en la sesión de shell o inyectarlas desde un gestor de
# secretos; esta carpeta está sincronizada con OneDrive.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-6
OPENAI_MODEL=openai/gpt-6.1-sol

# `python3 litellm/setup.py bootstrap` crea este usuario y una clave virtual.
AUDIT_USER_ID=prompt-auditor
AUDIT_USER_EMAIL=prompt-auditor@local.invalid
LITELLM_AUDITOR_KEY=
AUDIT_MODEL=audit-anthropic

REQUEST_TIMEOUT_SECONDS=120
MAX_OUTPUT_TOKENS=6000
MAX_ATTEMPTS=2
MAX_PARALLEL_PROMPTS=4
USE_JSON_SCHEMA=1
MAX_INPUT_CHARS=30000
FAIL_ON_FINDINGS=0

FAIL_ON=critical
EXIT_ON_FINDINGS=true
# Opcional: proxy externo, usado con docker compose run --no-deps prompt-analyzer
# LITELLM_BASE_URL=https://proxy.example/v1
