        </mxCell>
        <mxCell id="contracts-run-lane" value="&lt;b&gt;Corrida: summary.status&lt;/b&gt;&lt;br&gt;main() reemplaza el resumen al iniciar" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#f2f4f7;strokeColor=#8994a5;fontColor=#172b4d;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;verticalAlign=top;spacingTop=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="530" height="480" as="geometry" />
        </mxCell>
        <mxCell id="contracts-file-lane" value="&lt;b&gt;Archivo: results[].status&lt;/b&gt;&lt;br&gt;run_prompt_agent() aísla cada error" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#f2f4f7;strokeColor=#8994a5;fontColor=#172b4d;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;verticalAlign=top;spacingTop=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="145" width="530" height="480" as="geometry" />
        </mxCell>
        <mxCell id="contracts-model-lane" value="&lt;b&gt;Respuesta del juez&lt;/b&gt;&lt;br&gt;Pydantic + evidencia literal" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#f2f4f7;strokeColor=#8994a5;fontColor=#172b4d;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;verticalAlign=top;spacingTop=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="145" width="580" height="480" as="geometry" />
        </mxCell>
        <mxCell id="contracts-running" value="&lt;b&gt;RUNNING&lt;/b&gt;&lt;br&gt;Resumen inicial; results=[]&lt;br&gt;Interrupción: permanece RUNNING" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#e8f1ff;strokeColor=#4c78a8;fontColor=#172b4d;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="225" width="410" height="90" as="geometry" />
        </mxCell>
