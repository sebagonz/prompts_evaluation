        <mxCell id="contracts-title" value="&lt;b&gt;3. Contratos, estados y conversión a SARIF&lt;/b&gt;&lt;br&gt;Tres niveles de estado: corrida, archivo y consolidación · JSON conserva resultados; FAIL_ON filtra el SARIF final" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#e8f1ff;strokeColor=#4c78a8;fontColor=#172b4d;fontFamily=Helvetica;fontSize=24;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
