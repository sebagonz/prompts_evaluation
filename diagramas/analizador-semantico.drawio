        <mxCell id="functions-cli" value="&lt;b&gt;cli() → int&lt;/b&gt;&lt;br&gt;target; --defer-exit&lt;br&gt;Configura entorno y ejecuta main()" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#e8f1ff;strokeColor=#4c78a8;fontColor=#172b4d;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
